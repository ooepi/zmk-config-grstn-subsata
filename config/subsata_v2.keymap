#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &kp ESC         &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12         &kp PSCRN       &kp DEL         &kp HOME        &kp END         &kp C_MUTE
                &kp GRAVE       &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0          &kp MINUS       &kp EQUAL       &kp BSPC        &kp KP_NUM      &kp KP_SLASH    &kp KP_MULTIPLY &kp KP_MINUS
                &kp TAB         &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &kp I           &kp O           &kp P           &kp LBKT        &kp RBKT        &kp RET         &kp KP_N7       &kp KP_N8       &kp KP_N9       &kp KP_PLUS
                &kp CAPS        &kp A           &kp S           &kp D           &kp F           &kp G           &kp H           &kp J           &kp K           &kp L           &kp SEMI        &kp SQT         &kp NON_US_HASH &kp KP_N4       &kp KP_N5       &kp KP_N6
                &kp LSHFT       &kp NON_US_BSLH &kp Z           &kp X           &kp C           &kp V           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp RSHFT       &kp UP          &kp KP_N1       &kp KP_N2       &kp KP_N3       &kp KP_ENTER
                &kp LCTRL       &kp LGUI        &kp LALT        &kp SPACE       &kp RALT        &mo 1           &kp RCTRL       &kp LEFT        &kp DOWN        &kp RIGHT       &kp KP_N0       &kp KP_DOT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Hold Fn (right of Right Alt).
        // Esc: bootloader. F1-F5: Bluetooth profiles. F6: clear profile. F7/F8: USB/Bluetooth.
        // F10: LEDs on/off. F11/F12: dimmer/brighter. Print Screen: LED effect. Delete: restart.
        fn {
            display-name = "Fn";
            bindings = <
                &bootloader     &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &bt BT_CLR      &out OUT_USB    &out OUT_BLE    &trans          &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_EFF &sys_reset      &kp C_PREV      &kp C_NEXT      &kp C_PP
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp INS         &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp PG_UP       &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp HOME        &kp PG_DN       &kp END         &trans          &trans
            >;
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV>;
        };
    };
};
